e(w-2):\\n            ok=True\\n            for a in range(i,i+3):\\n                for b in range(j,j+3):\\n                    if grid[a][b]!=0: ok=False\\n            if ok:\\n                for a in range(i,i+3):\\n                    for b in range(j,j+3): hit[a][b]=True\\n    for i in range(h):\\n        for j in range(w):\\n            if hit[i][j]: out[i][j]=1\\n    return out\", \"def transform(grid):\\n    h=len(grid); w=len(grid[0]); out=[r[:] for r in grid]\\n    s=[[0]*(w+1) for _ in range(h+1)]\\n    for i in range(h):\\n        for j in range(w): s[i+1][j+1]=s[i][j+1]+s[i+1][j]-s[i][j]+(grid[i][j]!=0)\\n    for i in range(h-2):\\n        for j in range(w-2):\\n            z=s[i+3][j+3]-s[i][j+3]-s[i+3][j]+s[i][j]\\n            if z==0:\\n                for a in range(i,i+3):\\n                    for b in range(j,j+3): out[a][b]=1\\n    return out\", \"def transform(grid):\\n    h=len(grid); w=len(grid[0]); out=[r[:] for r in grid]\\n    good=[]\\n    for t in range(h):\\n        for b in range(t,h):\\n            for l in range(w):\\n                for r in range(l,w):\\n                    if b-t+1<3 or r-l+1<3: continue\\n                    ok=True\\n                    for i in range(t,b+1):\\n                        for j in range(l,r+1):\\n                            if grid[i][j]!=0: ok=False\\n                    if not ok: continue\\n                    if t>0 and all(grid[t-1][j]==0 for j in range(l,r+1)): continue\\n                    if b+1<h and all(grid[b+1][j]==0 for j in range(l,r+1)): continue\\n                    if l>0 and all(grid[i][l-1]==0 for i in range(t,b+1)): continue\\n                    if r+1<w and all(grid[i][r+1]==0 for i in range(t,b+1)): continue\\n                    good.append((t,b,l,r))\\n    for t,b,l,r in good:\\n        for i in range(t,b+1):\\n            for j in range(l,r+1): out[i][j]=1\\n    return out\", \"def transform(grid):\\n    h=len(grid); w=len(grid[0]); out=[r[:] for r in grid]\\n    for i in range(h):\\n        j=0\\n        while j<w:\\n            if grid[i][j]!=0: j+=1; continue\\n            k=j\\n            while k<w and grid[i][k]==0: k+=1\\n            if k-j>=3:\\n                top=i; bot=i\\n                while bot+1<h and all(grid[bot+1][x]==0 for x in range(j,k)): bot+=1\\n                if bot-top+1>=3:\\n                    for a in range(top,bot+1):\\n                        for b in range(j,k): out[a][b]=1\\n            j=k\\n    return out\", \"def transform(grid):\\n    h=len(grid); w=len(grid[0]); cnt={}\\n    for row in grid:\\n        for x in row: cnt[x]=cnt.get(x,0)+1\\n    bg=max(cnt,key=cnt.get)\\n    out=[r[:] for r in grid]\\n    for i in range(h-2):\\n        for j in range(w-2):\\n            ok=True\\n            for a in range(i,i+3):\\n                for b in range(j,j+3):\\n                    if grid[a][b]!=bg: ok=False\\n            if ok:\\n                for a in range(i,i+3):\\n                    for b in range(j,j+3): out[a][b]=1\\n    return out\", \"def transform(grid):\\n    h=len(grid); w=len(grid[0]); out=[r[:] for r in grid]\\n    for i in range(h-2):\\n        for j in range(w-2):\\n            if all(grid[a][b]==0 for a in range(i,i+3) for b in range(j,j+3)):\\n                for a in range(i,i+3):\\n                    for b in range(j,j+3): out[a][b]=1\\n    return out\", \"def transform(grid):\\n    h=len(grid); w=len(grid[0]); out=[r[:] for r in grid]\\n    cnt={}\\n    for row in grid:\\n        for x in row: cnt[x]=cnt.get(x,0)+1\\n    bg=max(cnt,key=cnt.get)\\n    for i in range(h-2):\\n        for j in range(w-2):\\n            bad=0\\n            for a in range(i,i+3):\\n                for b in range(j,j+3):\\n                    if grid[a][b]!=bg: bad+=1\\n            if bad<=1:\\n                for a in range(i,i+3):\\n                    for b in range(j,j+3): out[a][b]=1\\n    return out\", \"def transform(grid):\\n    h=len(grid); w=len(grid[0]); out=[r[:] for r in grid]\\n    fo