{"choices":[{"finish_reason":"stop","index":0,"logprobs":null,"message":{"content":"{\"hypotheses\":[\"def transform(grid):\\n    h=len(grid); w=len(grid[0])\\n    counts={}\\n    for row in grid:\\n        for x in row: counts[x]=counts.get(x,0)+1\\n    bg=max(counts,key=counts.get)\\n    pts=[(r,c) for r in range(h) for c in range(w) if grid[r][c]!=bg]\\n    if not pts: return [row[:] for row in grid]\\n    r0=min(r for r,c in pts); r1=max(r for r,c in pts)\\n    c0=min(c for r,c in pts); c1=max(c for r,c in pts)\\n    out=[row[:] for row in grid]\\n    for r in range(r0,r1+1):\\n        for c in range(c0,c1+1):\\n            if out[r][c]==bg: out[r][c]=2\\n    return out\",\"def transform(grid):\\n    h=len(grid); w=len(grid[0])\\n    counts={}\\n    for row in grid:\\n        for x in row: counts[x]=counts.get(x,0)+1\\n    best=max(counts.values()); bg=next(x for x in counts if counts[x]==best)\\n    pts=[(r,c) for r in range(h) for c in range(w) if grid[r][c]!=bg]\\n    if not pts: return [row[:] for row in grid]\\n    rs=[p[0] for p in pts]; cs=[p[1] for p in pts]\\n    out=[row[:] for row in grid]\\n    for r in range(min(rs),max(rs)+1):\\n        for c in range(min(cs),max(cs)+1):\\n            if out[r][c]==bg: out[r][c]=2\\n    return out\",\"def transform(grid):\\n    h=len(grid); w=len(grid[0])\\n    counts={}\\n    for row in grid:\\n        for x in row: counts[x]=counts.get(x,0)+1\\n    bg=max(counts,key=counts.get)\\n    fc={x:n for x,n in counts.items() if x!=bg}\\n    if not fc: return [row[:] for row in grid]\\n    rare=min(fc.values())\\n    chosen=next(x for x in fc if fc[x]==rare)\\n    pts=[(r,c) for r in range(h) for c in range(w) if grid[r][c]==chosen]\\n    rs=[p[0] for p in pts]; cs=[p[1] for p in pts]\\n    out=[row[:] for row in grid]\\n    for r in range(min(rs),max(rs)+1):\\n        for c in range(min(cs),max(cs)+1):\\n            if out[r][c]==bg: out[r][c]=2\\n    return out\",\"def transform(grid):\\n    h=len(grid); w=len(grid[0])\