{"choices":[{"finish_reason":"stop","index":0,"logprobs":null,"message":{"content":"{\"hypotheses\":[\"def transform(grid):\\n    h,w=len(grid),len(grid[0])\\n    from collections import Counter\\n    bg=Counter(x for r in grid for x in r).most_common(1)[0][0]\\n    pts=[(r,c,grid[r][c]) for r in range(h) for c in range(w) if grid[r][c]!=bg]\\n    out=[[bg]*w for _ in range(h)]\\n    if not pts:return out\\n    side='right' if sum(c==w-1 for r,c,v in pts)>=len(pts)/2 else 'left'\\n    if sum(r==0 or r==h-1 for r,c,v in pts)>len(pts)/2:\\n        side='top' if sum(r==0 for r,c,v in pts)>=sum(r==h-1 for r,c,v in pts) else 'bottom'\\n    for r,c,v in pts:\\n        if side in ('left','right'):\\n            for dr in (-1,0,1):\\n                rr=r+dr\\n                if 0<=rr<h:\\n                    for cc in range(w):\\n                        if (rr+cc-r-c)%2==0: out[rr][cc]=v\\n        else:\\n            for dc in (-1,0,1):\\n                cc=c+dc\\n                if 0<=cc<w:\\n                    for rr in range(h):\\n                        if (rr+cc-r-c)%2==0: out[rr][cc]=v\\n    return out\",\"def transform(grid):\\n    h,w=len(grid),len(grid[0])\\n    from collections import Counter\\n    bg=Counter(x for row in grid for x in row).most_common(1)[0][0]\\n    pts=[(r,c,grid[r][c]) for r in range(h) for c in range(w) if grid[r][c]!=bg]\\n    out=[[bg]*w for _ in range(h)]\\n    if not pts:return out\\n    vertical=sum(c in (0,w-1) for r,c,v in pts)>=sum(r in (0,h-1) for r,c,v in pts)\\n    for r,c,v in pts:\\n        if vertical:\\n            for rr in range(h):\\n                if abs(rr-r)<=1:\\n                    for cc in range(w):\\n                        if (rr+cc-r-c)%2==0:out[rr][cc]=v\\n        else:\\n            for cc in range(w):\\n                if abs(cc-c)<=1:\\n                    for rr in range(h):\\n                        if (rr+cc-r-c)%2==0:out[rr][cc]=v\\n    return out\",\"def transform(grid):\\n    h,w=len(grid),len(grid[0])\\