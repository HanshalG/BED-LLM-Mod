@@ -556,0 +558,17 @@ func (gameState *GameState) createClientGame() client.Game {
+// orderedSnakeStates removes Go map iteration from all behavior-relevant player
+// traversal. Player names are fixed by the experiment manifest; IDs break only
+// impossible duplicate-name ties.
+func (gameState *GameState) orderedSnakeStates() []SnakeState {
+	states := make([]SnakeState, 0, len(gameState.snakeStates))
+	for _, state := range gameState.snakeStates {
+		states = append(states, state)
+	}
+	sort.Slice(states, func(i, j int) bool {
+		if states[i].Name == states[j].Name {
+			return states[i].ID < states[j].ID
+		}
+		return states[i].Name < states[j].Name
+	})
+	return states
+}
